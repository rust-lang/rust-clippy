+/// Whether the source text at `span` is somewhere doc text is written: a string literal (`".."`,
+/// `r".."`, `r#".."#`) or a doc comment (`///`, `//!`, `/** */`, `/*! */`).
+///
+/// Doc comments have to be accepted too: when they pass through a proc macro they are turned into
+/// `#[doc = ".."]` attributes whose literal keeps the span of the original comment.
+///
+/// Returns `false` if the source text is unavailable, so that doc lints stay silent when the
+/// origin of the text can't be established.
+fn is_doc_text_source(cx: &LateContext<'_>, span: Span) -> bool {
+    const OPENERS: [&str; 7] = ["\"", "r\"", "r#", "///", "//!", "/**", "/*!"];
+    span.check_text(cx, |src| OPENERS.iter().any(|&opener| src.starts_with(opener)))
+}
+
 fn originated_from_include_str_macro(cx: &LateContext<'_>, span: Span) -> bool {
     root_macro_call(span).is_some_and(|macro_call| cx.tcx.is_diagnostic_item(sym::include_str_macro, macro_call.def_id))
 }
