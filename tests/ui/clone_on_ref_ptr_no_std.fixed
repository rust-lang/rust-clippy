#![warn(clippy::clone_on_ref_ptr)]
#![no_std]

extern crate alloc;
use alloc::rc::{Rc, Weak as RcWeak};
use alloc::sync::{Arc, Weak as ArcWeak};

fn clone_rc(x: &Rc<i32>) -> Rc<i32> {
    alloc::rc::Rc::<i32>::clone(x)
    //~^ clone_on_ref_ptr
}

fn clone_rc_owned(x: Rc<i32>) -> Rc<i32> {
    alloc::rc::Rc::<i32>::clone(&x)
    //~^ clone_on_ref_ptr
}

fn clone_weak(x: &RcWeak<i32>) -> RcWeak<i32> {
    alloc::rc::Weak::<i32>::clone(x)
    //~^ clone_on_ref_ptr
}

fn clone_arc(x: &Arc<i32>) -> Arc<i32> {
    alloc::sync::Arc::<i32>::clone(x)
    //~^ clone_on_ref_ptr
}

fn clone_arc_weak(x: &ArcWeak<i32>) -> ArcWeak<i32> {
    alloc::sync::Weak::<i32>::clone(x)
    //~^ clone_on_ref_ptr
}
