#![warn(clippy::iter_nth_zero)]
use std::collections::HashSet;

struct Foo;

impl Foo {
    fn nth(&self, index: usize) -> usize {
        index + 1
    }
}

fn main() {
    let f = Foo {};
    f.nth(0); // lint does not apply here

    let mut s = HashSet::new();
    s.insert(1);
    let _x = s.iter().next();
    //~^ iter_nth_zero

    let mut s2 = HashSet::new();
    s2.insert(2);
    let mut iter = s2.iter();
    let _y = iter.next();
    //~^ iter_nth_zero

    let mut s3 = HashSet::new();
    s3.insert(3);
    let mut iter2 = s3.iter();
    let _unwrapped = iter2.next().unwrap();
    //~^ iter_nth_zero
}

struct Issue9820;

impl Iterator for Issue9820 {
    type Item = ();

    fn nth(&mut self, _n: usize) -> Option<Self::Item> {
        todo!()
    }

    // Don't lint in implementations of `next`, as calling `next` in `next` is incorrect
    fn next(&mut self) -> Option<Self::Item> {
        self.nth(0)
    }
}

struct Issue18074;

impl Issue18074 {
    fn reproduce() -> Option<i32> {
        vec![1].into_iter().next()
        //~^ iter_nth_zero
    }
}

trait LintTraitItem {
    fn lint_trait_item() -> Option<i32> {
        vec![1].into_iter().next()
        //~^ iter_nth_zero
    }
}

struct LintClosure;

impl LintClosure {
    fn in_closure() -> Option<i32> {
        let f = || vec![1].into_iter().next();
        //~^ iter_nth_zero
        f()
    }
}

impl Default for LintClosure {
    fn default() -> Self {
        let _ = vec![1].into_iter().next();
        //~^ iter_nth_zero
        Self
    }
}

struct NestedIterNext;

impl Iterator for NestedIterNext {
    type Item = ();

    fn next(&mut self) -> Option<Self::Item> {
        // A nested fn is its own owner, so it is not part of `next`
        fn helper() -> Option<i32> {
            vec![1].into_iter().next()
            //~^ iter_nth_zero
        }
        helper();
        None
    }

    // Only `next` is excluded, other `Iterator` methods should still lint
    fn size_hint(&self) -> (usize, Option<usize>) {
        let _ = vec![1].into_iter().next();
        //~^ iter_nth_zero
        (0, None)
    }
}
