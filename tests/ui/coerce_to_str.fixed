#![warn(clippy::coerce_to_str)]
#![allow(clippy::needless_borrows_for_generic_args)]

use std::borrow::Cow;
use std::rc::Rc;
use std::sync::Arc;

trait TestTrait<T>
where
    T: AsRef<str>,
{
    fn test_fn(&self, _other_arg: i32, _string: T) {}
}

trait TestTrait2 {
    fn test_fn_2<T: AsRef<str>>(&self, _string: T) {}
}

struct TestStruct;

impl<T: AsRef<str>> TestTrait<T> for TestStruct {}
impl TestTrait2 for TestStruct {}

fn test_fn<T: AsRef<str>>(_other_arg: i32, _string: T) {}

fn test_fn_2(_str: &str) {}

fn main() {
    // Methods
    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let test_struct = TestStruct;
    test_struct.test_fn(42, "hello");
    //~^ coerce_to_str

    let test_struct = TestStruct;
    test_struct.test_fn_2("hello");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    let mut s = String::from("hello");
    s.push_str(" world");
    //~^ coerce_to_str

    // Functions
    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn(42, "hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str

    test_fn_2("hello");
    //~^ coerce_to_str
