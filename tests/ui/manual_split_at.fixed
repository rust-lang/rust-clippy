#![warn(clippy::manual_split_at)]
#![expect(clippy::useless_vec)]

fn main() {
    // one-line assignments
    let k = 3;

    let v = vec![1, 2, 3, 4, 5];
    let (left, right) = v.split_at(k);
    //~^ manual_split_at

    let slc: &[i32] = &[1, 2, 3, 4, 5];
    let (left, right) = slc.split_at(k);
    //~^ manual_split_at

    let arr = [1, 2, 3, 4, 5];
    let (left, right) = arr.split_at(k);
    //~^ manual_split_at

    let str_ = "hello";
    let (left, right) = str_.split_at(k);
    //~^ manual_split_at

    let string_ = String::from("hello");
    let (left, right) = string_.split_at(k);
    //~^ manual_split_at

    // field access as index
    struct Struct {
        field: usize,
    }
    let strct = Struct { field: 2 };

    let (left, right) = v.split_at(strct.field);
    //~^ manual_split_at

    // literal as index
    let (left, right) = v.split_at(2);
    //~^ manual_split_at

    // order of slices is swapped, binders are swapped in the suggestion
    let (left, right) = v.split_at(k);
    //~^ manual_split_at

    let ([first, ..], right) = v.split_at(k) else {
        //~^ manual_split_at
        return;
    };

    // works when type is specified
    let (left, right):(&[i32], &[i32]) = v.split_at(k);
    //~^ manual_split_at

    // partially specified
    let (left, right):(_, &[i32]) = v.split_at(k);
    //~^ manual_split_at

    // swapped with empty binders
    let (_, _) = v.split_at(k);
    //~^ manual_split_at

    // single binding, only the initializer is replaced
    let x = v.split_at(k);
    //~^ manual_split_at

    // different receivers - no lint
    let v1 = vec![1, 2, 3];
    let v2 = vec![1, 2, 3];
    let (_d1, _d2) = (&v1[..k], &v2[k..]);

    // index is not the same - no lint
    let (_d1, _d2) = (&v[..k], &v[k + 1..]);

    // possible side effects - no lint
    let (_d1, _d2) = (&v[..get_idx()], &v[get_idx()..]);

    // both ranges are OpFrom - no lint
    let (_d1, _d2) = (&arr[k..], &arr[k..]);

    // both ranges are OpTo - no lint
    let (_d1, _d2) = (&arr[..k], &arr[..k]);

    // swapped order but pattern is not a tuple - no lint
    let _y = (&arr[k..], &arr[..k]);

    // both ranges are inf - no lint
    let (_d1, _d2) = (&arr[..], &arr[..]);

    // reciever might have side effects - no lint
    let (_d1, _d2) = (&arr_func()[..k], &arr_func()[k..]);

    // two-line assignments

    //~v manual_split_at
    let (left, right) = v.split_at(k);

    // swapped order works as well
    //~v manual_split_at
    let (left, right) = v.split_at(k);

    //~v manual_split_at
    let (left, right) = v.split_at(strct.field);

    // mixed explicit type
    //~v manual_split_at
    let (left, right): (&[i32], _) = v.split_at(k);

    //~v manual_split_at
    let (left, right): (&[i32], &[i32]) = v.split_at(k);

    // different recievers - no lint
    let left: &[i32] = &v1[..k];
    let right: &[i32] = &v2[k..];

    // possible side effects - no lint
    let left = &arr_func()[..k];
    let right = &arr_func()[k..];

    let left = &v[..get_idx()];
    let right = &v[get_idx()..];
}

fn arr_func() -> [i32; 3] {
    [9, 1, 2]
}

fn get_idx() -> usize {
    2
}

#[clippy::msrv = "1.3"]
fn before_str_split_at_msrv() {
    let t = "hello";
    let k = 3;
    let (_, _) = (&t[..k], &t[k..]);

    let _ = &t[..k];
    let _ = &t[k..];
}

#[clippy::msrv = "1.4"]
fn after_str_split_at_msrv() {
    let t = "hello";
    let k = 3;

    let (_, _) = t.split_at(k);
    //~^ manual_split_at

    //~v manual_split_at
    let (_a, _b) = t.split_at(k);
}
