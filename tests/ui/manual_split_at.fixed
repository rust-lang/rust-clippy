#![warn(clippy::manual_split_at)]
#![expect(clippy::useless_vec)]

fn main() {
    let k = 3;

    let v = vec![1, 2, 3, 4, 5];
    let (left, right) = v.split_at(k);
    //~^ manual_split_at

    let v: &[i32] = &[1, 2, 3, 4, 5];
    let (left, right) = v.split_at(k);
    //~^ manual_split_at

    let a = [1, 2, 3, 4, 5];
    let (left, right) = a.split_at(k);
    //~^ manual_split_at

    let s = "hello";
    let (left, right) = s.split_at(k);
    //~^ manual_split_at

    let s = String::from("hello");
    let (left, right) = s.split_at(k);
    //~^ manual_split_at

    struct Bar {
        bar: usize,
    }
    let point = Bar { bar: 2 };
    let v = vec![1, 2, 3];
    let (left, right) = v.split_at(point.bar);
    //~^ manual_split_at

    let v = vec![1, 2, 3];
    let (left, right) = v.split_at(2);
    //~^ manual_split_at


    // different recievers - no lint
    let v1 = vec![1, 2, 3];
    let v2 = vec![1, 2, 3];
    let (_, _) = (&v1[..k], &v2[k..]);

    // index is not the same - no lint
    let v = vec![1, 2, 3];
    let (_, _) = (&v[..k], &v[k + 1..]);

    // swapped order, no lint
    let v = vec![1, 2, 3];
    let (_, _) = (&v[k..], &v[..k]);

    // possible side effects - no lint
    let v = vec![1, 2, 3];
    let (_, _) = (&v[..get_idx()], &v[get_idx()..]);
}

fn get_idx() -> usize {
    2
}


#[clippy::msrv = "1.3"]
fn _msrv_1_3() {
    let t = "hello";
    let k = 3;
    let (_, _) = (&t[..k], &t[k..]);
}

#[clippy::msrv = "1.4"]
fn msrv_1_4_str_split_at_stable() {
    let t = "hello";
    let k = 3;
    let (_, _) = t.split_at(k);
    //~^ manual_split_at
}
