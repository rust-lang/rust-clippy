#![warn(clippy::cow_to_owned)]

use std::borrow::Cow;
use std::ffi::OsStr;
use std::path::Path;

fn bytes() -> Cow<'static, [u8]> {
    Cow::Borrowed(&[])
}
fn path() -> Cow<'static, Path> {
    Cow::Borrowed(Path::new(""))
}
fn str() -> Cow<'static, str> {
    Cow::Borrowed("")
}
fn osstr() -> Cow<'static, OsStr> {
    Cow::Borrowed(OsStr::new(""))
}

fn main() {
    let _a = bytes().into_owned();
    //~^ cow_to_owned
    let _b = path().into_owned();
    //~^ cow_to_owned
    let _c = str().into_owned();
    //~^ cow_to_owned
    let _d = osstr().into_owned();
    //~^ cow_to_owned

    let _other = osstr().clone();
    #[allow(clippy::suspicious_to_owned)]
    let _other = osstr().to_owned();
}
