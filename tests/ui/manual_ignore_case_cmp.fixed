    a.eq_ignore_ascii_case(&b);
    //~^ manual_ignore_case_cmp
}
fn ref_u8vec(a: Vec<u8>, b: &Vec<u8>) {
    a.eq_ignore_ascii_case(b);
    //~^ manual_ignore_case_cmp
    b.eq_ignore_ascii_case(&a);
