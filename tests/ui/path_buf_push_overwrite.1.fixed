#![warn(clippy::path_buf_push_overwrite)]
#![allow(clippy::pathbuf_init_then_push)]

use std::path::PathBuf;

fn main() {
    let mut path = PathBuf::from("/foo");
    path.push("sh");
    //~^ path_buf_push_overwrite

    path.push(r#"sh"#);
    //~^ path_buf_push_overwrite

    path.push("user");
    //~^ path_buf_push_overwrite

    path.push(r#"user"#);
    //~^ path_buf_push_overwrite

    path.push("sh")
}

fn mut_ref(path: &mut PathBuf) {
    path.push("sh");
    //~^ path_buf_push_overwrite
}

fn boxed() {
    let mut path = Box::new(PathBuf::from("/foo"));
    path.push("sh");
    //~^ path_buf_push_overwrite
}

fn guard(cell: &std::cell::RefCell<PathBuf>) {
    cell.borrow_mut().push("sh");
    //~^ path_buf_push_overwrite
}

fn temporary() {
    PathBuf::new().push("sh");
    //~^ path_buf_push_overwrite
}

fn multiple_deref() {
    let path = &mut &mut &mut PathBuf::from("/foo");
    path.push("sh");
    //~^ path_buf_push_overwrite

    struct DerefWrapper<T: ?Sized>(T);
    impl<T: ?Sized> std::ops::Deref for DerefWrapper<T> {
        type Target = T;
        fn deref(&self) -> &Self::Target {
            &self.0
        }
    }
    impl<T: ?Sized> std::ops::DerefMut for DerefWrapper<T> {
        fn deref_mut(&mut self) -> &mut Self::Target {
            &mut self.0
        }
    }

    use std::sync::Mutex;
    let path = Mutex::new(DerefWrapper(DerefWrapper(PathBuf::from("/foo"))));
    path.lock().unwrap().push("sh");
    //~^ path_buf_push_overwrite
}
