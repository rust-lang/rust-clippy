//@only-target: x86_64
#![warn(clippy::call_missing_target_feature)]
#![allow(clippy::missing_safety_doc)]

#[target_feature(enable = "avx2")]
pub unsafe fn test_f() {
    unsafe { f() };
    //~^ call_missing_target_feature
}

#[target_feature(enable = "avx2,pclmulqdq")]
pub(crate) unsafe fn test_g() {
    unsafe { g() };
    //~^ ERROR: this call requires target features
}

#[target_feature(enable = "avx2,pclmulqdq")]
unsafe fn test_h() {
    unsafe { h() };
    //~^ ERROR: this call requires target features
}

#[target_feature(enable = "avx2,pclmulqdq")]
unsafe fn test_h_unsafe() {
    unsafe { h() };
    //~^ ERROR: this call requires target features
}

// calls behind a runtime feature check are conditional and should not lint
fn test_runtime_guarded() {
    if is_x86_feature_detected!("avx2") {
        unsafe { f() };
    }
}

#[target_feature(enable = "avx2")]
unsafe fn f() -> u32 {
    0
}

#[target_feature(enable = "avx2,pclmulqdq")]
unsafe fn g() -> u32 {
    0
}

#[target_feature(enable = "avx2")]
#[target_feature(enable = "pclmulqdq")]
unsafe fn h() -> u32 {
    0
}

// checks for false positives. this test should not return errors
#[target_feature(enable = "avx2")]
unsafe fn test_f_valid() {
    unsafe { f() };
}
