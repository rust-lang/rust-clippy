#![warn(clippy::assert_is_empty)]
#![expect(clippy::needless_ifs, clippy::useless_vec)]
#![allow(clippy::const_is_empty)]

fn main() {
    let vec = vec![1, 2, 3];
    assert_eq!(vec, [] as [i32; 0]);
    //~^ assert_is_empty
    assert_ne!(vec, [] as [i32; 0]);
    //~^ assert_is_empty
    debug_assert_eq!(vec, [] as [i32; 0]);
    //~^ assert_is_empty
    debug_assert_ne!(vec, [] as [i32; 0]);
    //~^ assert_is_empty

    let vec_ref = &vec;
    assert_eq!(vec_ref.as_slice(), []);
    //~^ assert_is_empty
    assert_ne!(vec_ref.as_slice(), []);
    //~^ assert_is_empty

    let vec_mut_ref = &mut vec![1, 2, 3];
    assert_eq!(vec_mut_ref.as_slice(), []);
    //~^ assert_is_empty

    let slice: &[i32] = &[1, 2, 3];
    assert_eq!(slice, []);
    //~^ assert_is_empty
    assert_ne!(slice, []);
    //~^ assert_is_empty

    let array = [1, 2, 3];
    assert_eq!(array.as_slice(), []);
    //~^ assert_is_empty
    assert_ne!(array.as_slice(), []);
    //~^ assert_is_empty

    let array_ref = &array;
    assert_eq!(array_ref.as_slice(), []);
    //~^ assert_is_empty

    let string = String::from("foo");
    assert_eq!(string, "");
    //~^ assert_is_empty
    assert_ne!(string, "");
    //~^ assert_is_empty

    let str_ref = "foo";
    assert_eq!(str_ref, "");
    //~^ assert_is_empty
    assert_ne!(str_ref, "");
    //~^ assert_is_empty

    // Don't lint: has assert message.
    assert!(vec.is_empty(), "items should be empty");
    assert!(!vec.is_empty(), "items should not be empty");
    assert!(vec.is_empty(), "unexpected values: {vec:?}");
    assert!(!vec.is_empty(), "unexpected values: {vec:?}");

    // Common chained assertion shape. The first assertion can hide the value
    // that the second assertion would otherwise help diagnose.
    let items = vec!["baz"];
    assert_ne!(items, [] as [&str; 0]);
    //~^ assert_is_empty
    assert_eq!(items[0], "bar");

    // Don't lint: the outer `assert!` is written here, but the condition comes
    // from a macro expansion. Rewriting the expanded condition span would make
    // the suggestion point at generated code rather than source code.
    macro_rules! is_empty {
        ($value:expr) => {
            $value.is_empty()
        };
    }
    assert!(is_empty!(vec));

    // Don't lint: the `assert!` itself comes from a macro expansion. The lint
    // only rewrites assert calls that are present at the call site.
    macro_rules! assert_empty {
        ($value:expr) => {
            assert!($value.is_empty())
        };
    }
    assert_empty!(vec);

    // Don't lint: not an assert macro.
    if vec.is_empty() {}
    if !vec.is_empty() {}

    // Don't lint: assert_eq! would require Debug and PartialEq for the element type.
    struct NotDebugOrPartialEq;
    let not_debug_or_partial_eq = vec![NotDebugOrPartialEq];
    assert!(not_debug_or_partial_eq.is_empty());

    #[derive(Debug)]
    struct NotPartialEq;
    let not_partial_eq = vec![NotPartialEq];
    assert!(not_partial_eq.is_empty());

    #[derive(PartialEq)]
    struct NotDebug;
    let not_debug = vec![NotDebug];
    assert!(not_debug.is_empty());

    hashmaps::lint();
    hashmaps::do_not_lint();
}

mod issue17935 {
    use std::collections::BinaryHeap;

    fn binary_heap() {
        let mut heap = BinaryHeap::new();
        heap.push(42);
        assert_eq!(heap.as_slice(), [] as [i32; 0]);
        //~^ assert_is_empty
        assert_ne!(heap.as_slice(), [] as [i32; 0]);
        //~^ assert_is_empty
        debug_assert_eq!(heap.as_slice(), [] as [i32; 0]);
        //~^ assert_is_empty
        debug_assert_ne!(heap.as_slice(), [] as [i32; 0]);
        //~^ assert_is_empty

        // Don't lint: has assert message.
        assert!(heap.is_empty(), "expected an empty heap");
    }

    trait ElementExists {
        const ELEMENT: Self;
    }

    fn binaryheap_eq<T: ElementExists + Ord + std::fmt::Debug>() {
        let mut heap = BinaryHeap::new();
        heap.push(T::ELEMENT);
        assert_eq!(heap.as_slice(), [] as [T; 0]);
        //~^ assert_is_empty
    }

    fn cross_eq<T: Ord + std::fmt::Debug + PartialEq<u8>>(heap: BinaryHeap<T>) {
        assert_eq!(heap.as_slice(), [] as [T; 0]);
        //~^ assert_is_empty
    }

    fn references(heap: &mut BinaryHeap<i32>) {
        assert_eq!(heap.as_slice(), [] as [i32; 0]);
        //~^ assert_is_empty

        let heap_ref = &*heap;
        assert_eq!(heap_ref.as_slice(), [] as [i32; 0]);
        //~^ assert_is_empty

        let heap_ref_ref = &heap_ref;
        assert_ne!(heap_ref_ref.as_slice(), [] as [i32; 0]);
        //~^ assert_is_empty

        let heap = &&heap;
        assert_ne!(heap.as_slice(), [] as [i32; 0]);
        //~^ assert_is_empty
    }

    // Don't lint: these element types do not support the suggestion.
    fn not_debug() {
        #[derive(Eq, Ord, PartialEq, PartialOrd)]
        struct NotDebug;

        let mut not_debug = BinaryHeap::new();
        not_debug.push(NotDebug);
        assert!(not_debug.is_empty());
    }

    fn binaryheap_normal<T: ElementExists + Ord>() {
        let mut heap = BinaryHeap::new();
        heap.push(T::ELEMENT);
        assert!(heap.is_empty());
    }

    fn opaque(heap: BinaryHeap<impl Ord + std::fmt::Debug>) {
        assert!(heap.is_empty());
    }

    fn not_comparable<T: std::fmt::Debug>(heap: BinaryHeap<T>) {
        assert!(heap.is_empty());
    }

    const fn const_heap(heap: &BinaryHeap<i32>) {
        assert!(heap.is_empty());
        assert!(!heap.is_empty());
        debug_assert!(heap.is_empty());
        debug_assert!(!heap.is_empty());
    }
}

// TODO: turn into an MSRV aware lint after const traits are stable and `PartialEq` is const stable
mod issue17930 {
    const NOT_EMPTY: &str = "string";
    const EMPTY: &str = "";
    const X: () = assert!(!NOT_EMPTY.is_empty());
    static Y: () = assert!(EMPTY.is_empty());

    const fn in_constant_fn() {
        assert!(EMPTY.is_empty())
    }

    fn in_constant() {
        const {
            assert!(!NOT_EMPTY.is_empty());
        }
    }

    struct ImplWithConstMethod;

    impl ImplWithConstMethod {
        const Z: () = assert!(!NOT_EMPTY.is_empty());

        const fn const_method(&self) {
            assert!(EMPTY.is_empty());
        }
    }
}

mod hashmaps {
    // References issue #17936
    use std::collections::HashMap;

    pub(super) fn lint() {
        let mut hashmap: HashMap<&str, i32> = HashMap::new();
        assert!(hashmap.is_empty(), "assertion `is empty` failed, contents: {hashmap:?}");
        //~^ assert_is_empty
        assert!(!hashmap.is_empty(), "assertion `is not empty` failed, contents: {hashmap:?}");
        //~^ assert_is_empty
        debug_assert!(hashmap.is_empty(), "assertion `is empty` failed, contents: {hashmap:?}");
        //~^ assert_is_empty
        debug_assert!(!hashmap.is_empty(), "assertion `is not empty` failed, contents: {hashmap:?}");
        //~^ assert_is_empty
        let hashmap_ref = &hashmap;
        assert!(hashmap_ref.is_empty(), "assertion `is empty` failed, contents: {hashmap_ref:?}");
        //~^ assert_is_empty
        assert!(!hashmap_ref.is_empty(), "assertion `is not empty` failed, contents: {hashmap_ref:?}");
        //~^ assert_is_empty

        let hashmap_double_ref = &&hashmap;
        assert!(hashmap_double_ref.is_empty(), "assertion `is empty` failed, contents: {hashmap_double_ref:?}");
        //~^ assert_is_empty
        assert!(!hashmap_double_ref.is_empty(), "assertion `is not empty` failed, contents: {hashmap_double_ref:?}");
        //~^ assert_is_empty

        let hashmap_mut_ref = &mut hashmap;
        assert!(hashmap_mut_ref.is_empty(), "assertion `is empty` failed, contents: {hashmap_mut_ref:?}");
        //~^ assert_is_empty
        assert!(!hashmap_mut_ref.is_empty(), "assertion `is not empty` failed, contents: {hashmap_mut_ref:?}");
        //~^ assert_is_empty
    }

    // Don't lint: custom message requires Debug for the key and value types.
    #[derive(PartialEq, Eq, Hash)]
    struct NotDebug;

    pub(super) fn do_not_lint() {
        // Key type doesn't implement Debug
        let mut hash_map: HashMap<NotDebug, u8> = HashMap::new();
        assert!(hash_map.is_empty());
        hash_map.insert(NotDebug, 42);
        assert!(!hash_map.is_empty());

        // Value type doesn't implement Debug
        let mut hash_map: HashMap<u8, NotDebug> = HashMap::new();
        assert!(hash_map.is_empty());
        hash_map.insert(42, NotDebug);
        assert!(!hash_map.is_empty());
    }
}
