    assert!(0x7FFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF == 0x7fff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_i128); //~ decimal_literal_representation
    assert!(0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF == 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_u128); //~ decimal_literal_representation

